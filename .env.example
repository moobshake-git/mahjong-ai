# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.
#
# Jev through OpenCode (OpenCode Zen). Get a key from your OpenCode Console account.
JEV_API_KEY=
JEV_API_URL=https://opencode.ai/inference/systemone/v1/systemone
# jev-1.13-free is free on OpenCode for a limited time; jev-1.13 is the paid model.
JEV_MODEL=jev-1.13-free

# To call TypeSafe AI directly instead, use their key and:
# JEV_API_URL=https://thejevai.com/v1/systemone
# JEV_MODEL=typesafe/jev-1.14

# Optional: live camera (Claude reads the table from the video when it's still).
# Needs:  pip install anthropic
# Each read is one Claude request with one image. claude-haiku-5-5 is much cheaper per read.
# ANTHROPIC_API_KEY=
# VISION_MODEL=claude-opus-5-5
